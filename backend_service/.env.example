# Local development values. `npm run dev` copies this file to `.env` when `.env` is missing.
# The API, `npm run db:setup` and the Prisma CLI read `backend_service/.env`.

API_PORT=3000

# MySQL server for every tenant database (spec §3.1). Each tenant's database name from the
# registry (cert_syd, cert_per, cert_adl) is appended. MySQL from docker-compose.yml listens on
# host port 3307 (MYSQL_PORT), so it doesn't clash with a MySQL already on 3306. If you change
# MYSQL_PORT, change it here too.
DATABASE_URL_BASE=mysql://root:root@127.0.0.1:3307

# Prisma CLI only (e.g. `npm run db:migrate:new -w backend_service` to write a new migration).
# The API and db:setup don't use it.
DATABASE_URL=mysql://root:root@127.0.0.1:3307/cert_syd

# Test-only: prepended to every tenant database name (the e2e harness sets it so test runs get
# their own databases). Leave unset for development.
# TENANT_DATABASE_PREFIX=
