# Local development values. `npm run dev` copies this file to `.env` when `.env` is missing.
# The Prisma CLI and the API both read `backend_service/.env`.

API_PORT=3000

# M1-M2 run as a single tenant: Sydney (spec D48).
# MySQL from docker-compose.yml listens on host port 3307 (MYSQL_PORT), so it doesn't clash
# with a MySQL already running on 3306. If you change MYSQL_PORT, change it here too.
DATABASE_URL=mysql://root:root@127.0.0.1:3307/cert_syd
APP_TIMEZONE=Australia/Sydney
APP_SERIAL_PREFIX=SYD

# M3: each tenant's database name is appended to this. Tests also create their throwaway
# databases on this server.
DATABASE_URL_BASE=mysql://root:root@127.0.0.1:3307

# Test-only: prepended to every tenant database name (the e2e harness sets it so test runs get
# their own databases). Leave unset for development.
# TENANT_DATABASE_PREFIX=
